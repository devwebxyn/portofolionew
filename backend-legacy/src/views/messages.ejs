<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Pesan Masuk</title>
  <style>
    body { font-family: system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial; background:#0b0b0f; color:#fff; }
    header { display:flex; align-items:center; justify-content:space-between; padding:16px; border-bottom:1px solid #2a2d3a; }
    main { max-width:960px; margin:0 auto; padding:16px; }
    table { width:100%; border-collapse: collapse; }
    th, td { border-bottom:1px solid #2a2d3a; padding:10px; text-align:left; }
    .status { font-size:12px; padding:4px 8px; border-radius:999px; border:1px solid #2a2d3a; }
    .unread { font-weight:700; }
    a { color:#10b981; text-decoration:none; }
  </style>
</head>
<body>
  <header>
    <div>Pesan Masuk</div>
    <div style="display:flex; gap:12px;">
      <a href="/admin/dashboard">Dashboard</a>
      <a href="/admin/logout">Keluar</a>
    </div>
  </header>
  <main>
    <table>
      <thead>
        <tr>
          <th>Tanggal</th>
          <th>Judul</th>
          <th>Email</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <% items.forEach(function(m){ %>
          <tr class="<%= m.status === 'unread' ? 'unread' : '' %>">
            <td><%= new Date(m.createdAt).toLocaleString() %></td>
            <td><a href="/admin/messages/<%= m.$id %>"><%= m.subject %></a></td>
            <td><%= m.senderEmail %></td>
            <td><span class="status"><%= m.status %></span></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </main>
</body>
</html>
