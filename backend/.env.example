# --- CORS: origins lain yang diizinkan (regex, koma untuk banyak) ---
ALLOWED_ORIGINS=https://samuelindrabastian.me,https://admin.vercel.app

# --- Standalone server (local / non-Vercel) ---
PORT=4000
