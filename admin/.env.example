# Base URL backend Go (tanpa trailing slash). Server-side only — jangan pakai NEXT_PUBLIC.
# Dev: backend lokal (cd backend && go run ./cmd/server) → port 4000.
# Prod: ganti ke URL Vercel backend (mis. https://portfolio-backend.vercel.app)
API_URL=http://localhost:4000

# Nama cookie sesi (opsional, default "auth")
# AUTH_COOKIE=auth
